    "purpose": "Route B assertion authentication and distinct mTLS token binding"
  },
  "api-gateway-introspection": {
    "client_authentication": "tls_client_auth",
    "keycloak_authenticator": "client-x509",
    "certificate_file": "api-introspection.crt",
