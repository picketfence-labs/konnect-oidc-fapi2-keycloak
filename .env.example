# Konnect の Terraform と decK の認証情報
KONNECT_TOKEN=
KONNECT_SERVER_URL=https://us.api.konghq.com

# 任意の上書き設定
TF_VAR_control_plane_name=keycloak-fapi2-demo

# make validate 用の非機密な既定値。runtime targetはTerraform outputから生成します。
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=validation-only
KEYCLOAK_REFRESH_TOKEN_ROTATION=true
ROUTE_B_JWK={}
ROUTE_A_TLS_CERT=validation-certificate
ROUTE_A_TLS_KEY=validation-private-key
ROUTE_B_TLS_CERT=validation-certificate
ROUTE_B_TLS_KEY=validation-private-key
KONNECT_API_CP_HOST=validation-api.cp.konghq.com
KONNECT_API_TP_HOST=validation-api.tp.konghq.com
KONNECT_THIRD_PARTY_CP_HOST=validation-third-party.cp.konghq.com
KONNECT_THIRD_PARTY_TP_HOST=validation-third-party.tp.konghq.com
