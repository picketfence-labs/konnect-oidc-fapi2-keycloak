# Konnect の Terraform と decK の認証情報
KONNECT_TOKEN=
KONNECT_SERVER_URL=https://us.api.konghq.com

# Auth0 Terraform provider の認証情報（デモ専用テナントを推奨）
AUTH0_DOMAIN=example.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# 任意の上書き設定
TF_VAR_control_plane_name=oidc-routing-demo
TF_VAR_enable_par=false
# 既定の Auth0 database connection に残す既存 client ID を JSON 配列で指定します。
# 共用テナントでは live API の一覧を確認してから設定してください。
TF_VAR_default_db_existing_client_ids='[]'
# 実利用では管理下の URI を指定してください。
# TF_VAR_claim_namespace=https://oidc-demo.example.com
