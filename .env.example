# Konnect の Terraform と decK の認証情報
KONNECT_TOKEN=
KONNECT_SERVER_URL=https://us.api.konghq.com

# 任意の上書き設定
TF_VAR_control_plane_name=keycloak-fapi2-demo

# make validate 用の非機密な既定値。make generate-dev-assets が実行時の値を
# .generated/runtime.env に生成し、make up で上書きします。
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=validation-only
ROUTE_B_JWK={}
ROUTE_A_TLS_CERT=validation-certificate
ROUTE_A_TLS_KEY=validation-private-key
ROUTE_B_TLS_CERT=validation-certificate
ROUTE_B_TLS_KEY=validation-private-key
KONNECT_CP_HOST=validation.cp.konghq.com
KONNECT_TP_HOST=validation.tp.konghq.com
