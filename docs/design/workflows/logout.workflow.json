{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Route別LogoutとRefresh Token失効",
    "animation": "none",
    "quality_profile": "showcase",
    "output": "logout.workflow.html"
  },
  "lanes": [
    {
      "id": "browser",
      "label": "利用者・ブラウザー"
    },
    {
      "id": "kong",
      "label": "Kong Gateway"
    },
    {
      "id": "keycloak",
      "label": "Keycloak"
    },
    {
      "id": "evidence",
      "label": "受入証跡",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "request",
      "label": "Route別logout",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "revoke",
      "label": "Refresh Token失効とlocal session破棄",
      "fromCol": 2,
      "toCol": 3,
      "variant": "security"
    },
    {
      "id": "sso",
      "label": "Keycloak SSO終了と再ログイン",
      "fromCol": 4,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "click_logout",
    "route_logout",
    "revoke_token",
    "revoke_ok",
    "destroy_session",
    "redirect_logout",
    "keycloak_logout",
    "return_ui"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "click_logout"
    ],
    "allowedTerminals": [
      "return_ui",
      "wire_pending"
    ],
    "requiredPaths": [
      {
        "from": "click_logout",
        "to": "revoke_token"
      },
      {
        "from": "revoke_token",
        "to": "keycloak_logout"
      },
      {
        "from": "keycloak_logout",
        "to": "return_ui"
      }
    ]
  },
  "nodes": [
    {
      "id": "click_logout",
      "lane": "browser",
      "col": 0,
      "type": "frontend",
      "label": "対象Routeからログアウト",
      "sublabel": "Route A / Route B",
      "width": 165
    },
    {
      "id": "route_logout",
      "lane": "kong",
      "col": 1,
      "type": "backend",
      "label": "Route sessionを解決",
      "sublabel": "専用cookie + logout suffix",
      "width": 175
    },
    {
      "id": "revoke_token",
      "lane": "kong",
      "col": 2,
      "type": "security",
      "label": "Refresh Tokenを失効",
      "sublabel": "A=mTLS／B=stock PKJWT",
      "tag": "設定済み",
      "width": 185
    },
    {
      "id": "revoke_ok",
      "lane": "keycloak",
      "col": 2,
      "type": "security",
      "label": "Revocationを受理",
      "sublabel": "/protocol/openid-connect/revoke",
      "width": 185
    },
    {
      "id": "destroy_session",
      "lane": "kong",
      "col": 3,
      "type": "database",
      "label": "Kong sessionを破棄",
      "sublabel": "Route専用cookieを失効",
      "width": 175
    },
    {
      "id": "redirect_logout",
      "lane": "kong",
      "col": 4,
      "type": "cloud",
      "label": "Keycloakへredirect",
      "sublabel": "end_session_endpoint",
      "width": 170
    },
    {
      "id": "keycloak_logout",
      "lane": "keycloak",
      "col": 4,
      "type": "external",
      "label": "Keycloak SSOを終了",
      "sublabel": "RP-Initiated Logout",
      "width": 180
    },
    {
      "id": "return_ui",
      "lane": "browser",
      "col": 5,
      "type": "frontend",
      "label": "Route selectorへ戻る",
      "sublabel": "反対Routeは新しい認可フロー",
      "width": 180
    },
    {
      "id": "wire_pending",
      "lane": "evidence",
      "col": 3,
      "type": "security",
      "label": "Wire-level証跡を取得",
      "sublabel": "refresh replay・cookie・SSO・Route切替",
      "tag": "未完了",
      "width": 200
    }
  ],
  "edges": [
    {
      "from": "click_logout",
      "to": "route_logout",
      "label": "Route別logout URI",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "from": "route_logout",
      "to": "revoke_token",
      "label": "session内refresh token",
      "variant": "security",
      "role": "main"
    },
    {
      "from": "revoke_token",
      "to": "revoke_ok",
      "label": "A: tls_client_auth / B: private_key_jwt",
      "variant": "security",
      "role": "main"
    },
    {
      "from": "revoke_ok",
      "to": "destroy_session",
      "label": "revoked",
      "variant": "emphasis",
      "role": "return"
    },
    {
      "from": "destroy_session",
      "to": "redirect_logout",
      "role": "main"
    },
    {
      "from": "redirect_logout",
      "to": "keycloak_logout",
      "label": "id_token_hint + post_logout_redirect_uri",
      "role": "main"
    },
    {
      "from": "keycloak_logout",
      "to": "return_ui",
      "label": "redirect",
      "variant": "emphasis",
      "role": "return"
    },
    {
      "from": "destroy_session",
      "to": "wire_pending",
      "label": "自動受入テスト未実施",
      "variant": "dashed",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "実装済み設定",
      "items": [
        "Routeごとのlogout URL・cookie・session secretを分離",
        "Route AはmTLS、Route Bはstock private_key_jwtでrevocation",
        "Keycloak end_session_endpointからUIへ復帰"
      ]
    },
    {
      "dot": "amber",
      "title": "未完了の受入証跡",
      "items": [
        "古いrefresh tokenで再発行できないこと",
        "Kong cookieとKeycloak SSO sessionの終了",
        "logout後に反対Routeで新しい認可が始まること"
      ]
    },
    {
      "dot": "rose",
      "title": "判定上の注意",
      "items": [
        "confirmation画面の有無は合格条件にしない",
        "token値をログへ出さずRouteとphaseだけを記録",
        "失効失敗時の継続動作もwire-levelで確認する"
      ]
    }
  ]
}
