{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Route別LogoutとToken失効（設計）",
    "animation": "none",
    "quality_profile": "showcase",
    "output": "logout.workflow.html"
  },
  "lanes": [
    {
      "id": "browser",
      "label": "Browser / 3rd Party UI"
    },
    {
      "id": "tpgw",
      "label": "3rd Party Gateway"
    },
    {
      "id": "keycloak",
      "label": "Keycloak"
    },
    {
      "id": "apigw",
      "label": "API Gateway",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "request",
      "label": "Route別logout",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "revoke",
      "label": "Token失効とlocal session破棄",
      "fromCol": 2,
      "toCol": 3,
      "variant": "security"
    },
    {
      "id": "sso",
      "label": "Keycloak SSO終了とUIへ復帰",
      "fromCol": 4,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "click_logout",
    "route_logout",
    "revoke_token",
    "revoke_ok",
    "destroy_session",
    "redirect_logout",
    "keycloak_logout",
    "return_ui"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "click_logout"
    ],
    "allowedTerminals": [
      "return_ui",
      "replay_reject"
    ],
    "requiredPaths": [
      {
        "from": "click_logout",
        "to": "revoke_token"
      },
      {
        "from": "revoke_token",
        "to": "keycloak_logout"
      },
      {
        "from": "keycloak_logout",
        "to": "return_ui"
      },
      {
        "from": "revoke_ok",
        "to": "replay_reject"
      }
    ]
  },
  "nodes": [
    {
      "id": "click_logout",
      "lane": "browser",
      "col": 0,
      "type": "frontend",
      "label": "対象Routeからログアウト",
      "sublabel": "Route A / Route B",
      "width": 190
    },
    {
      "id": "route_logout",
      "lane": "tpgw",
      "col": 1,
      "type": "backend",
      "label": "Route sessionを解決",
      "sublabel": "専用cookie + logout suffix",
      "width": 175
    },
    {
      "id": "revoke_token",
      "lane": "tpgw",
      "col": 2,
      "type": "security",
      "label": "Tokenを失効",
      "sublabel": "refresh + access token",
      "width": 175
    },
    {
      "id": "revoke_ok",
      "lane": "keycloak",
      "col": 2,
      "type": "security",
      "label": "Revocationを受理",
      "sublabel": "/protocol/openid-connect/revoke",
      "width": 185
    },
    {
      "id": "destroy_session",
      "lane": "tpgw",
      "col": 3,
      "type": "database",
      "label": "Local sessionを破棄",
      "sublabel": "Route専用cookieを失効",
      "width": 175
    },
    {
      "id": "redirect_logout",
      "lane": "tpgw",
      "col": 4,
      "type": "cloud",
      "label": "Keycloakへredirect",
      "sublabel": "end_session_endpoint",
      "width": 170
    },
    {
      "id": "keycloak_logout",
      "lane": "keycloak",
      "col": 4,
      "type": "external",
      "label": "Keycloak SSOを終了",
      "sublabel": "RP-Initiated Logout",
      "width": 180
    },
    {
      "id": "return_ui",
      "lane": "browser",
      "col": 5,
      "type": "frontend",
      "label": "Route selectorへ戻る",
      "sublabel": "反対Routeは新しい認可フロー",
      "width": 180
    },
    {
      "id": "replay_reject",
      "lane": "apigw",
      "col": 3,
      "type": "security",
      "label": "失効tokenの再送を拒否",
      "sublabel": "active=false → 401",
      "width": 185
    }
  ],
  "edges": [
    {
      "from": "click_logout",
      "to": "route_logout",
      "label": "Route別logout URI",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "from": "route_logout",
      "to": "revoke_token",
      "label": "session内token",
      "variant": "security",
      "role": "main"
    },
    {
      "from": "revoke_token",
      "to": "revoke_ok",
      "label": "A: tls_client_auth / B: private_key_jwt",
      "variant": "security",
      "role": "main"
    },
    {
      "from": "revoke_ok",
      "to": "destroy_session",
      "label": "revoked",
      "variant": "emphasis",
      "role": "return"
    },
    {
      "from": "destroy_session",
      "to": "redirect_logout",
      "role": "main"
    },
    {
      "from": "redirect_logout",
      "to": "keycloak_logout",
      "label": "id_token_hint + post_logout_redirect_uri",
      "role": "main"
    },
    {
      "from": "keycloak_logout",
      "to": "return_ui",
      "label": "redirect",
      "variant": "emphasis",
      "role": "return"
    },
    {
      "from": "revoke_ok",
      "to": "replay_reject",
      "label": "introspection",
      "variant": "dashed",
      "role": "branch"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "設計（未実装）",
      "items": [
        "目標設計。LOGOUT-A/B-01・REVOKE-RS-01で検証する"
      ]
    },
    {
      "dot": "rose",
      "title": "RS側の失効反映",
      "items": [
        "introspection cacheは無効化またはTTL 30秒以下",
        "正しいcertで再送しても401（WWW-Authenticate付き）"
      ]
    }
  ]
}
