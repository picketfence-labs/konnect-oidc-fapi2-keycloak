{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "次ケースへ進むLogout / Reset（デモ設計）",
    "animation": "none",
    "quality_profile": "showcase",
    "output": "logout.workflow.html"
  },
  "lanes": [
    {
      "id": "browser",
      "label": "Browser / 3rd Party UI"
    },
    {
      "id": "tpgw",
      "label": "3rd Party Gateway"
    },
    {
      "id": "keycloak",
      "label": "Keycloak"
    }
  ],
  "phases": [
    {
      "id": "request",
      "label": "Route別logout",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "revoke",
      "label": "Stock revokeとlocal session破棄",
      "fromCol": 2,
      "toCol": 3,
      "variant": "security"
    },
    {
      "id": "sso",
      "label": "Keycloak SSO終了とUIへ復帰",
      "fromCol": 4,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "click_logout",
    "route_logout",
    "revoke_token",
    "revoke_ok",
    "destroy_session",
    "redirect_logout",
    "keycloak_logout",
    "return_ui"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "click_logout"
    ],
    "allowedTerminals": [
      "return_ui"
    ],
    "requiredPaths": [
      {
        "from": "click_logout",
        "to": "revoke_token"
      },
      {
        "from": "revoke_token",
        "to": "keycloak_logout"
      },
      {
        "from": "keycloak_logout",
        "to": "return_ui"
      }
    ]
  },
  "nodes": [
    {
      "id": "click_logout",
      "lane": "browser",
      "col": 0,
      "type": "frontend",
      "label": "対象Routeからログアウト",
      "sublabel": "Route A / Route B",
      "width": 190
    },
    {
      "id": "route_logout",
      "lane": "tpgw",
      "col": 1,
      "type": "backend",
      "label": "Route sessionを解決",
      "sublabel": "専用cookie + logout suffix",
      "width": 175
    },
    {
      "id": "revoke_token",
      "lane": "tpgw",
      "col": 2,
      "type": "security",
      "label": "Revokeを要求",
      "sublabel": "refresh → access token",
      "width": 175
    },
    {
      "id": "revoke_ok",
      "lane": "keycloak",
      "col": 2,
      "type": "security",
      "label": "Revocationを受理",
      "sublabel": "/protocol/openid-connect/revoke",
      "width": 185
    },
    {
      "id": "destroy_session",
      "lane": "tpgw",
      "col": 3,
      "type": "database",
      "label": "Local sessionを破棄",
      "sublabel": "Route専用cookieを失効",
      "width": 175
    },
    {
      "id": "redirect_logout",
      "lane": "tpgw",
      "col": 4,
      "type": "cloud",
      "label": "Keycloakへredirect",
      "sublabel": "end_session_endpoint",
      "width": 170
    },
    {
      "id": "keycloak_logout",
      "lane": "keycloak",
      "col": 4,
      "type": "external",
      "label": "Keycloak SSOを終了",
      "sublabel": "RP-Initiated Logout",
      "width": 180
    },
    {
      "id": "return_ui",
      "lane": "browser",
      "col": 5,
      "type": "frontend",
      "label": "Route selectorへ戻る",
      "sublabel": "反対Routeは新しい認可フロー",
      "width": 180
    }
  ],
  "edges": [
    {
      "from": "click_logout",
      "to": "route_logout",
      "label": "Route別logout URI",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "from": "route_logout",
      "to": "revoke_token",
      "label": "session内token",
      "variant": "security",
      "role": "main"
    },
    {
      "from": "revoke_token",
      "to": "revoke_ok",
      "label": "mTLS + Route別client認証",
      "variant": "security",
      "role": "main"
    },
    {
      "from": "revoke_ok",
      "to": "destroy_session",
      "label": "HTTP 200",
      "variant": "emphasis",
      "role": "return"
    },
    {
      "from": "destroy_session",
      "to": "redirect_logout",
      "role": "main"
    },
    {
      "from": "redirect_logout",
      "to": "keycloak_logout",
      "label": "id_token_hint + post_logout_redirect_uri",
      "role": "main"
    },
    {
      "from": "keycloak_logout",
      "to": "return_ui",
      "label": "redirect",
      "variant": "emphasis",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "デモ運用（未実装）",
      "items": [
        "通常経路はstock logout。次ケースの新規loginを確認",
        "HTTP 200やreset成功からtoken個別失効を保証しない"
      ]
    },
    {
      "dot": "cyan",
      "title": "Resetの合格条件",
      "items": [
        "Route cookie/SSOをresetし別Route・userへ切替",
        "revoke失敗はcertなし再送せず対象user限定reset"
      ]
    }
  ]
}
