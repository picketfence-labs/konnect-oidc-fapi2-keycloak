  "cards": [
    {
      "dot": "emerald",
      "title": "Live確認済み",
      "items": [
        "PAR、browser login、code exchange、Upstream mTLSが成功",
        "PS256 assertionとcertificate-bound tokenを併用",
        "claim由来headerとPoP bindingをUIで確認"
