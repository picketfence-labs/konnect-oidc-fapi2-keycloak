    },
    {
      "dot": "violet",
      "title": "Endpoint別の責任分担",
      "items": [
        "PAR・revocation：stock OIDC private_key_jwt",
        "token・refresh：bridgeがPKJWTを生成しstock mTLS transportへ渡す",
        "同じRSA鍵を環境変数Vault参照で共有"
      ]
    },
    {
      "dot": "amber",
      "title": "残る受入証跡",
      "items": [
        "refresh・revocation・logoutのwire-level証跡",
        "誤audience・jti replay・証明書なし・assertion注入の拒否",
        "Gateway upgrade時の内部契約回帰試験"
