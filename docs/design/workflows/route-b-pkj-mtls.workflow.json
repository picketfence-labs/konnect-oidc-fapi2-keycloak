  "cards": [
    {
      "dot": "emerald",
      "title": "Pass condition",
      "items": [
        "Keycloak verifies the client assertion and TLS certificate",
        "The assertion audience equals the Keycloak issuer",
        "The protected API verifies the certificate-bound token"
      ]
    },
    {
      "dot": "rose",
      "title": "Plugin security boundary",
      "items": [
        "Reject client-supplied assertion parameters before OIDC runs",
        "Generate a fresh jti for each token or refresh request",
        "Remove internal assertion transport before the upstream call"
      ]
    },
    {
      "dot": "cyan",
      "title": "Upgrade contract",
      "items": [
        "Pin Kong Gateway 3.16.0.0 for the first implementation",
        "Test token and refresh requests at the wire level",
        "Fail the build when Kong internal module behavior changes"
      ]
    }
  ]
}
