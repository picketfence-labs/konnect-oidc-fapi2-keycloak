      "role": "main"
    },
    {
      "from": "call_b",
      "to": "rs_b",
      "label": "mTLS + Bearer",
      "variant": "security",
      "role": "main"
    },
    {
      "from": "rs_b",
      "to": "verify_b",
      "label": "mTLS upstream cert",
      "variant": "security",
      "role": "main"
    }
