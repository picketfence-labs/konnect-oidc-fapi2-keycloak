{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Route A：mTLSクライアント認証（設計）",
    "animation": "none",
    "quality_profile": "showcase",
    "output": "route-a-mtls.workflow.html",
    "viewBox": [
      1200,
      660
    ]
  },
  "lanes": [
    {
      "id": "tpgw",
      "label": "3rd Party Gateway（UIからRoute Aを選択）"
    },
    {
      "id": "keycloak",
      "label": "Keycloak"
    },
    {
      "id": "apigw",
      "label": "API Gateway"
    },
    {
      "id": "upstream",
      "label": "Upstream API"
    }
  ],
  "phases": [
    {
      "id": "start",
      "label": "PAR",
      "fromCol": 0,
      "toCol": 0
    },
    {
      "id": "authorize",
      "label": "ユーザー認証とCallback",
      "fromCol": 1,
      "toCol": 2,
      "variant": "emphasis"
    },
    {
      "id": "token",
      "label": "コード交換と証明書束縛",
      "fromCol": 3,
      "toCol": 3,
      "variant": "security"
    },
    {
      "id": "resource",
      "label": "API Gatewayでの検証",
      "fromCol": 4,
      "toCol": 5,
      "variant": "security"
    }
  ],
  "mainPath": [
    "par_a",
    "login_a",
    "callback_a",
    "token_a",
    "call_a",
    "rs_a",
    "verify_a"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "par_a"
    ],
    "allowedTerminals": [
      "verify_a"
    ],
    "requiredPaths": [
      {
        "from": "par_a",
        "to": "token_a"
      },
      {
        "from": "token_a",
        "to": "rs_a"
      },
      {
        "from": "rs_a",
        "to": "verify_a"
      }
    ]
  },
  "nodes": [
    {
      "id": "par_a",
      "lane": "tpgw",
      "col": 0,
      "type": "security",
      "label": "PARを送信",
      "sublabel": "PKCE S256 + tls_client_auth",
      "width": 190
    },
    {
      "id": "login_a",
      "lane": "keycloak",
      "col": 1,
      "type": "external",
      "label": "利用者を認証",
      "sublabel": "local demo user",
      "width": 155
    },
    {
      "id": "callback_a",
      "lane": "tpgw",
      "col": 2,
      "type": "backend",
      "label": "Callbackを検証",
      "sublabel": "state・PKCE・iss必須",
      "width": 170
    },
    {
      "id": "token_a",
      "lane": "keycloak",
      "col": 3,
      "type": "security",
      "label": "Route A certで認証",
      "sublabel": "access / refresh tokenを証明書へ束縛",
      "width": 205
    },
    {
      "id": "call_a",
      "lane": "tpgw",
      "col": 4,
      "type": "cloud",
      "label": "API Gatewayを呼出し",
      "sublabel": "Bearer header + 同じRoute A cert",
      "width": 205
    },
    {
      "id": "rs_a",
      "lane": "apigw",
      "col": 5,
      "type": "security",
      "label": "introspection + PoP検証",
      "sublabel": "cnf.x5t#S256 = TLS peer cert",
      "width": 205
    },
    {
      "id": "verify_a",
      "lane": "upstream",
      "col": 5,
      "type": "backend",
      "label": "JWT再検証・evidence",
      "sublabel": "X-Client-Cert ↔ cnf・azp→route",
      "width": 205
    }
  ],
  "edges": [
    {
      "from": "par_a",
      "to": "login_a",
      "label": "request_uri",
      "role": "main"
    },
    {
      "from": "login_a",
      "to": "callback_a",
      "label": "code + iss",
      "role": "main"
    },
    {
      "from": "callback_a",
      "to": "token_a",
      "label": "code + verifier + Route A cert",
      "variant": "security",
      "role": "main"
    },
    {
      "from": "token_a",
      "to": "call_a",
      "label": "証明書束縛token",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "from": "call_a",
      "to": "rs_a",
      "label": "mTLS + Bearer",
      "variant": "security",
      "role": "main"
    },
    {
      "from": "rs_a",
      "to": "verify_a",
      "label": "mTLS upstream cert",
      "variant": "security",
      "role": "main"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "設計（未実装）",
      "items": [
        "目標設計。live検証はA-E2E-01・A-CNF-01で行う"
      ]
    },
    {
      "dot": "cyan",
      "title": "Route Aの要点",
      "items": [
        "PAR・token・revocationはstock OIDCのtls_client_auth",
        "iss欠落の認可レスポンスはOIDC plugin前に400で拒否"
      ]
    }
  ]
}
