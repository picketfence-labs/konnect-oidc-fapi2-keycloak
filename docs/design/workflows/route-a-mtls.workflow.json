      "id": "exchange",
      "label": "コード交換",
      "fromCol": 3,
      "toCol": 3,
      "variant": "security"
    },
    {
      "id": "protected",
      "label": "API検査と結果表示",
      "fromCol": 4,
      "toCol": 5,
      "variant": "security"
    }
  ],
  "groups": [
    {
      "id": "service_group_a",
      "label": "3rd Partyサービス",
      "lane": "third-party",
      "fromCol": 0,
      "toCol": 0
    },
    {
      "id": "kong_group_a",
      "label": "Kong Gateway（OAuthクライアント）",
      "lane": "third-party",
      "fromCol": 1,
      "toCol": 4,
      "variant": "security"
    }
  ],
  "mainPath": [
    "ui_a",
    "choose_a",
    "par_a",
    "par_accept_a",
    "callback_a",
    "token_a",
    "api_call_a",
    "api_validate_a",
    "resource_a",
    "result_a"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "ui_a"
    ],
