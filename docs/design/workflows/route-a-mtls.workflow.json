        "from": "choose_a",
        "to": "par_accept_a"
      },
      {
        "from": "callback_a",
        "to": "token_a"
      },
      {
        "from": "api_call_a",
        "to": "resource_a"
      }
    ]
  },
  "nodes": [
    {
      "id": "ui_a",
      "lane": "third-party",
      "col": 0,
      "type": "frontend",
      "label": "デモUIを配信",
      "sublabel": "nginx / 静的サービス",
      "width": 200
    },
    {
      "id": "choose_a",
      "lane": "user",
      "col": 0,
      "type": "external",
      "label": "Route Aを選択",
      "sublabel": "ブラウザーでRoute Aへ",
      "width": 200
    },
    {
      "id": "par_a",
      "lane": "third-party",
      "col": 1,
      "type": "security",
      "label": "PARを送信",
      "sublabel": "PKCE S256 / tls_client_auth",
      "width": 200
    },
    {
      "id": "par_accept_a",
      "lane": "idp",
      "col": 2,
      "type": "security",
      "label": "PAR受理・利用者認証",
      "sublabel": "Keycloakのログイン画面",
      "width": 200
    },
    {
      "id": "callback_a",
      "lane": "third-party",
      "col": 3,
      "type": "security",
      "label": "callback・コード交換",
      "sublabel": "state・提示issを確認",
      "width": 200
    },
    {
      "id": "token_a",
      "lane": "idp",
      "col": 3,
      "type": "security",
      "label": "認証・コード交換",
      "sublabel": "TLS認証 / A証明書へ束縛",
      "width": 200
    },
    {
      "id": "api_call_a",
      "lane": "third-party",
      "col": 4,
      "type": "backend",
      "label": "保護APIを呼び出す",
      "sublabel": "Bearer + Route A証明書",
      "width": 200
    },
    {
      "id": "api_validate_a",
      "lane": "api",
      "col": 4,
      "type": "security",
      "label": "token・PoPを検査",
      "sublabel": "introspection / cnf照合",
      "width": 200
    },
    {
      "id": "resource_a",
      "lane": "resource",
      "col": 5,
      "type": "backend",
      "label": "JWTと束縛を再検証",
      "sublabel": "元client証明書とcnfを照合",
      "width": 200
    },
    {
      "id": "result_a",
      "lane": "user",
      "col": 5,
      "type": "external",
      "label": "UIで結果を確認",
      "sublabel": "claim/header・署名・束縛",
      "width": 200
    }
  ],
  "edges": [
    {
      "id": "ui-to-choose_a",
      "from": "ui_a",
      "to": "choose_a",
      "label": "HTTPS / UI取得",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "choose-to-par_a",
      "from": "choose_a",
      "to": "par_a",
      "label": "Route Aへアクセス",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "par-to-par_accept_a",
      "from": "par_a",
      "to": "par_accept_a",
      "label": "PAR + 認可画面へ",
      "variant": "security",
      "role": "main"
    },
    {
      "id": "par_accept-to-callback_a",
      "from": "par_accept_a",
      "to": "callback_a",
      "label": "code・state・iss",
      "variant": "default",
      "role": "main"
    },
    {
      "id": "callback-to-token_a",
      "from": "callback_a",
      "to": "token_a",
      "label": "code + verifier",
      "variant": "security",
      "role": "main"
    },
    {
      "id": "token-to-api_call_a",
      "from": "token_a",
      "to": "api_call_a",
      "label": "証明書束縛token",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "api_call-to-api_validate_a",
      "from": "api_call_a",
      "to": "api_validate_a",
      "label": "mTLS + Bearer",
      "variant": "security",
      "role": "main"
    },
    {
      "id": "api_validate-to-resource_a",
      "from": "api_validate_a",
      "to": "resource_a",
      "label": "mTLS / token・証跡",
      "variant": "security",
      "role": "main"
    },
    {
      "id": "resource-to-result_a",
      "from": "resource_a",
      "to": "result_a",
      "label": "HTTPS / 検証結果",
      "variant": "default",
      "role": "main"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "認証方式と送信者制約",
      "items": [
        "クライアント認証は標準OIDCのtls_client_auth",
        "API呼出しにはtoken取得時と同じRoute A証明書を使用",
        "PAR・コード交換はmTLS。認可画面への遷移はブラウザーのHTTPS"
      ]
    },
    {
      "dot": "amber",
      "title": "補完と検証範囲",
      "items": [
        "AS送信guard・metadata mTLSは専用transportで補完",
        "API GatewayはKeycloakへmTLS introspection。保護APIはJWTを再検証",
        "承認済みデモ範囲で受入済み。iss欠落・開始CSRFは未対応"
      ]
    }
  ]
}
